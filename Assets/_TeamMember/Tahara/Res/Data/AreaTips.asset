  - "\u30A8\u30EA\u30A2\u306F\u30B9\u30C6\u30FC\u30B8\u4E2D\u592E\u306E\u67A0\u306B\u56F2\u307E\u308C\u305F\u30A8\u30EA\u30A2\u3092\u53D6\u308A\u5408\u3046\u30EB\u30FC\u30EB\n\u30A8\u30EA\u30A2\u306B\u81EA\u5206\u305F\u3061\u306E\u30C1\u30FC\u30E0\u3060\u3051\u304C\u5165\u3063\u3066\u3044\u308B\u3068\u30AB\u30A6\u30F3\u30C8\u304C\u9032\u3080\u305E\uFF01"
  - "\u30A8\u30EA\u30A2\u306B\u5225\u30C1\u30FC\u30E0\u304C\u3044\u308B\u3068\u30AB\u30A6\u30F3\u30C8\u306F\u6B62\u307E\u308B\n\u5168\u54E1\u3067\u30A8\u30EA\u30A2\u306B\u5165\u3063\u3066\u30AB\u30A6\u30F3\u30C8\u3092\u53D6\u308A\u623B\u305B\uFF01"
  - "\u30B9\u30C6\u30FC\u30B8\u306E\u5730\u5F62\u3092\u5229\u7528\u3057\u3088\u3046\n\u3042\u3093\u306A\u3068\u3053\u308D\u3084\u3053\u3093\u306A\u3068\u3053\u308D\u306B\u307E\u3067\u767B\u308C\u3061\u3083\u3046\u304B\u3082\uFF01\uFF1F"
