  m_Name: ExplaneScentences
  m_EditorClassIdentifier: 
  explanes:
  - "\u30AF\u30E9\u30A6\u30F3\u306F\u30B9\u30C6\u30FC\u30B8\u4E2D\u592E\u306E\u738B\u51A0\u3092\u53D6\u308A\u5408\u3046\u30EB\u30FC\u30EB\u3002\n\u5148\u306B\u30AB\u30A6\u30F3\u30C8\u309250\u9032\u3081\u305F\u30C1\u30FC\u30E0\u306E\u52DD\u5229\u3060\u3002\n\u30AF\u30E9\u30A6\u30F3\u3092\u6301\u3064\u30D7\u30EC\u30A4\u30E4\u30FC\u3092\u5012\u3059\u3068\u596A\u3044\u8FD4\u305B\u308B\u305E!"
  - "\u30A8\u30EA\u30A2\u306F\u30B9\u30C6\u30FC\u30B8\u4E2D\u592E\u306E\u67A0\u306B\u56F2\u307E\u308C\u305F\u30A8\u30EA\u30A2\u3092\u53D6\u308A\u5408\u3046\u30EB\u30FC\u30EB\u3002\n\u30A8\u30EA\u30A2\u306B\u81EA\u5206\u305F\u3061\u306E\u30C1\u30FC\u30E0\u3060\u3051\u304C\u5165\u3063\u3066\u3044\u308B\u3068\u30AB\u30A6\u30F3\u30C8\u304C\u9032\u3080\u3002"
  - "\u30C7\u30B9\u30DE\u30C3\u30C1\u306F\u76F8\u624B\u30C1\u30FC\u30E0\u3092\u5012\u3057\u305F\u56DE\u6570\u3067\u52DD\u8CA0\u3059\u308B\u30EB\u30FC\u30EB\u3002\n\u69D8\u3005\u306A\u6B66\u5668\u3001\u30A2\u30A4\u30C6\u30E0\u3092\u4F7F\u3063\u3066\u52DD\u5229\u3092\u76EE\u6307\u305B!"
