  explanes:
  - "\u30AF\u30E9\u30A6\u30F3\u306F\u30B9\u30C6\u30FC\u30B8\u4E2D\u592E\u306E\u738B\u51A0\u3092\u53D6\u308A\u5408\u3046\u30EB\u30FC\u30EB\n\u5148\u306B\u30AB\u30A6\u30F3\u30C8\u309250\u9032\u3081\u305F\u30C1\u30FC\u30E0\u306E\u52DD\u5229\u3060\uFF01"
  - "\u30AF\u30E9\u30A6\u30F3\u3092\u6301\u3063\u305F\u30D7\u30EC\u30A4\u30E4\u30FC\u3092\u5012\u3059\u3068\u30AF\u30E9\u30A6\u30F3\u304C\u30C9\u30ED\u30C3\u30D7\u3059\u308B\n\u7A4D\u6975\u7684\u306B\u72D9\u3063\u3066\u3044\u3053\u3046\uFF01"
  - "\u30AF\u30E9\u30A6\u30F3\u3067\u306F\u3044\u304B\u306B\u30AF\u30E9\u30A6\u30F3\u3092\u6301\u3063\u305F\u30D7\u30EC\u30A4\u30E4\u30FC\u3092\u5B88\u308C\u308B\u304B\u304C\u52DD\u8CA0\u3060\n\u80CC\u5F8C\u304B\u3089\u306E\u5947\u8972\u306B\u6C17\u3092\u3064\u3051\u308D\uFF01"
